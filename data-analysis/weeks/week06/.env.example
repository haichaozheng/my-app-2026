# DeepSeek API 密钥模板（供 llm_api.ipynb 课后自学使用）

# 用法：
#   1. 复制本文件为 .env（Windows 命令： copy .env.example .env ；Mac/Linux： cp .env.example .env）
#   2. 把下面的 sk-你的APIKey 换成你在 https://platform.deepseek.com/ 申请的真实密钥
#   3. notebook 中先运行 load_dotenv()，再用 os.getenv('Deepseek_API_KEY') 读取
#
# 安全提醒：.env 已在 .gitignore，不会提交入库；不要把密钥硬编码进代码或提交到仓库
# 官方文档：https://api-docs.deepseek.com/zh-cn/

Deepseek_API_KEY="你的APIKey"
